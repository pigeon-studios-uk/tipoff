# Tipoff settings
# Copy this file to .env and fill in your own values. Never commit .env or share it: the token controls your bot.
# Everything a server changes (channels, roles, reasons, limits) is set in Discord with /setup, not here.

# --- Discord (required) ---
# Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_TOKEN=
# Developer Portal -> your application -> General Information -> Application ID.
DISCORD_CLIENT_ID=
# For testing only: register every command in this one server instead of globally. Leave empty when live.
COMMANDS_GUILD_ID=

# --- Database (required) ---
# MariaDB 10.6+ or MySQL 8+. With Docker Compose, leave MYSQL_HOST as db: that's the database container.
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=tipoff
# Pick a long random password. Docker Compose uses it to create the database user the first time.
MYSQL_PASS=
MYSQL_DB=tipoff

# --- Health check ---
# GET /health answers 200 while everything works, 503 when something doesn't. If empty, Tipoff uses the PORT or
# SERVER_PORT your host gives it, or 3000.
HTTP_PORT=

# --- Your links (optional) ---
# Shown in /help and elsewhere. Links you leave empty aren't shown. These are for YOUR copy: your privacy policy and
# terms cover the data your bot handles.
WEBSITE_URL=
GUIDE_URL=
PRIVACY_URL=
TERMS_URL=
SUPPORT_URL=
STATUS_URL=
